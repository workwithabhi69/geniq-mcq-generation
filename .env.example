# GENIQ Environment Configuration
# Add your Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Model Configuration (configurable, default: gemini-2.5-flash and gemini-2.5-flash-lite or gemini-1.5-flash)
PRIMARY_MODEL=gemini-2.5-flash
LITE_MODEL=gemini-2.5-flash-lite

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Research / Evaluation Parameters
RANDOM_SEED=42
EVAL_SAMPLE_SIZE=200
DATABASE_URL=sqlite:///./geniq.db
